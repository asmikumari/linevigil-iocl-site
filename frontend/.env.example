# Free CARTO Basemaps API key for the dark map tiles: https://carto.com/basemaps/apikey
# Leave empty to use the keyless Esri dark basemap instead.
VITE_CARTO_API_KEY=

# Optional: API and Socket.IO origins. Defaults: localhost:5001 in development, same domain in production.
# VITE_API_URL=
# VITE_SOCKET_URL=
